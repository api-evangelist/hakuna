{
  "opencollection": "1.0.0",
  "info": {
    "name": "hakuna Time Tracking Absences Overview API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Overview",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get overview metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hakuna.ch/api/v1/overview"
          },
          "docs": "Retrieve key metrics for the authenticated user, such as overtime and vacation balances."
        }
      ]
    }
  ],
  "bundled": true
}