{
  "opencollection": "1.0.0",
  "info": {
    "name": "hakuna Time Tracking Absences Organization API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get organization status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hakuna.ch/api/v1/organization/status"
          },
          "docs": "Retrieve the presence and absence status for all users in the organization. Requires an organization-level token."
        }
      ]
    }
  ],
  "bundled": true
}