{
  "opencollection": "1.0.0",
  "info": {
    "name": "hakuna Time Tracking Absences Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hakuna.ch/api/v1/users"
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Get the authenticated user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hakuna.ch/api/v1/users/me"
          },
          "docs": "Get the authenticated user"
        }
      ]
    }
  ],
  "bundled": true
}